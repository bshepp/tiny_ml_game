# .agentignore - Files and directories that AI agents should ignore or be careful with

# Dependencies and node_modules (too large, auto-generated)
node_modules/
/.pnp
.pnp.js

# Python virtual environment (environment-specific)
venv/
env/
ENV/
__pycache__/

# Build outputs (auto-generated)
build/
dist/
coverage/
.cache/

# Package locks (auto-generated, very large)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Cache and temporary files
.eslintcache
.stylelintcache
*.tsbuildinfo
.tmp/
.temp/
*.tmp
*.temp

# Binary and large data files
*.pb
*.h5
*.tflite
*.savedmodel/
*.tfjs_model/
*.csv
*.json.gz
*.parquet
*.zip
*.tar.gz
*.tgz

# Git internals (version control system files)
.git/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Environment and secrets
.env*
*.pem
*.key
*.crt

# Log files (can be very large)
*.log
logs/

# Claude AI specific
.claude/

# Test coverage and reports (auto-generated)
coverage/
.nyc_output/
test-results/
cypress/videos/
cypress/screenshots/

# Documentation that doesn't need AI modification
LICENSE
CHANGELOG.md